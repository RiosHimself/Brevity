{
  "id": "./",
  "name": "Brevity",
  "short_name": "Brevity",
  "description": "Build HTML emails that survive Gmail. Blocks, circular photo frames, themes and signatures, then copy the email into Gmail.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDEEF1",
  "theme_color": "#FFFFFF",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-brevity": [
          ".brevity"
        ]
      }
    }
  ]
}
